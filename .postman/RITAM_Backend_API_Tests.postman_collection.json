{
  "info": {
    "_postman_id": "ritam-backend-api-tests",
    "name": "RITAM Backend API Tests",
    "description": "API collection for testing the RITAM multi-tenant backend. Set the baseUrl and tokens before running protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "facultyToken",
      "value": ""
    },
    {
      "key": "verifierToken",
      "value": ""
    },
    {
      "key": "coordinatorToken",
      "value": ""
    },
    {
      "key": "activityId",
      "value": "15"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Faculty Tenant 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faculty.a@example.test\",\n  \"password\": \"FacultyA-Local-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Verifier Tenant 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"verifier.a@example.test\",\n  \"password\": \"VerifierA-Local-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Coordinator Tenant 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coordinator.a@example.test\",\n  \"password\": \"Coord-Local-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Faculty Tenant 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faculty.b@example.test\",\n  \"password\": \"FacultyB-Local-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Get My Activities - Faculty",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{facultyToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/activities/mine"
          }
        },
        {
          "name": "Submit Activity - Configure Form Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{facultyToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "event_name",
                  "value": "Sample Workshop",
                  "type": "text"
                },
                {
                  "key": "event_type",
                  "value": "WORKSHOP",
                  "type": "text"
                },
                {
                  "key": "start_date",
                  "value": "2026-08-15",
                  "type": "text"
                },
                {
                  "key": "end_date",
                  "value": "2026-08-16",
                  "type": "text"
                },
                {
                  "key": "attended_as",
                  "value": "Participant",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/activities"
          }
        }
      ]
    },
    {
      "name": "Verification",
      "item": [
        {
          "name": "Get Verification Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{verifierToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/verification/queue"
          }
        },
        {
          "name": "Approve Activity - Use Pending ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{verifierToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/verification/{{activityId}}/approve"
          }
        },
        {
          "name": "Reject Activity - Use Pending ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{verifierToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Supporting document is unclear\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/verification/{{activityId}}/reject"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Reports Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary"
          }
        },
        {
          "name": "Reports Summary - Filtered",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary?academic_year=2026-27&department=CSE"
          }
        }
      ]
    }
  ]
}